@{
ViewData["Title"] = "Admin Panel";
}

<div class="container mt-4">
    <h1>ADMIN PANEL</h1>

<p>Welcome, @User.Identity?.Name!</p>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card p-4">
            <h3>Products</h3>
            <p>Total products: <strong>@ViewBag.ProductsCount</strong></p>

            <a asp-controller="Admin"
               asp-action="Products"
               class="btn btn-primary">
                MANAGE PRODUCTS
            </a>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card p-4">
            <h3>Categories</h3>
            <p>Total categories: <strong>@ViewBag.CategoriesCount</strong></p>

            <a asp-controller="Admin"
               asp-action="Categories"
               class="btn btn-primary">
                MANAGE CATEGORIES
            </a>
        </div>
    </div>
</div>

</div>
