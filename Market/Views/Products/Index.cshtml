@model IEnumerable<Market.Models.Product>

@{
    ViewData["Title"] = "Amber Market";
}

<div class="market-header">
    <h1>AMBER MARKET</h1>
    <p>Counter-Strike 2 skins marketplace</p>
</div>

<div class="sort-bar">

    <label for="sort">SORT BY</label>

    <form asp-action="Index" method="get">

        <select id="sort"
                name="sort"
                onchange="this.form.submit()">

            <option value="">DEFAULT</option>

            <option value="price_asc"
                    selected="@(Context.Request.Query["sort"] == "price_asc")">
                PRICE ↑
            </option>

            <option value="price_desc"
                    selected="@(Context.Request.Query["sort"] == "price_desc")">
                PRICE ↓
            </option>

            <option value="name"
                    selected="@(Context.Request.Query["sort"] == "name")">
                NAME
            </option>

            <option value="rating"
                    selected="@(Context.Request.Query["sort"] == "rating")">
                ★ RATING ↓
            </option>

        </select>

    </form>

</div>

<div class="category-bar" id="categories">
    @foreach (var category in Model.Select(p => p.Category).DistinctBy(c => c.Id))
    {
        <a href="#category-@category.Id">
            @category.Name
        </a>
    }
</div>

@foreach (var category in Model.Select(p => p.Category).DistinctBy(c => c.Id))
{
    <section class="category-section" id="category-@category.Id">

        <div class="category-title">
            <h2>@category.Name</h2>
        </div>

        <div class="product-grid">

            @{
                var categoryProducts = Model
                    .Where(p => p.CategoryId == category.Id);

                categoryProducts = ViewBag.Sort switch
                {
                    "price_asc" => categoryProducts.OrderBy(p => p.Price),
                    "price_desc" => categoryProducts.OrderByDescending(p => p.Price),
                    "name" => categoryProducts.OrderBy(p => p.Name),
                    "rating" => categoryProducts.OrderByDescending(p => p.Rating),
                    _ => categoryProducts
                };
            }

            @foreach (var product in categoryProducts)
            {
                <a asp-action="Details"
                   asp-route-id="@product.Id"
                   class="product-card">

                    <div class="skin-image">
                        <span class="rarity-badge">@product.Rarity</span>

                        <img src="@product.ImagePath"
                             alt="@product.Name" />
                    </div>

                    <div class="product-info">

                        <div class="product-name-row">
                            <h2>@product.Name</h2>
                        </div>

                        <p class="weapon">
                            @product.Category.Name
                        </p>

                        <div class="product-meta">
                            <span class="condition">
                                @product.Condition
                            </span>

                            <span class="rating">
                                ★ @product.Rating.ToString("0.0")
                            </span>

                            <span class="price">
                                $@product.Price
                            </span>
                        </div>

                    </div>

                </a>
            }

        </div>

    </section>
}
