@model Market.Models.Product

@{
ViewData["Title"] = Model.Name;
}

<div class="details-page">

<a asp-action="Index" class="back-button">
    ← BACK TO MARKET
</a>

<div class="details-card">

    <div class="details-image">
        <img src="@Model.ImagePath"
             alt="@Model.Name" />
    </div>

    <div class="details-info">

        <span class="details-category">
            @Model.Category?.Name
        </span>

        <h1>@Model.Name</h1>

        <div class="rarity">
            @Model.Rarity
        </div>

        <p class="description">
            @Model.Description
        </p>

        <div class="details-properties">

            <div>
                <span>CONDITION</span>
                <strong>@Model.Condition</strong>
            </div>

            <div>
                <span>RARITY</span>
                <strong>@Model.Rarity</strong>
            </div>

            <div>
                <span>CATEGORY</span>
                <strong>@Model.Category?.Name</strong>
            </div>

        </div>

        <div class="details-purchase">

            <span class="details-price">
                $@Model.Price
            </span>

            <button class="btn btn-primary details-buy-button">
                BUY SKIN
            </button>

        </div>

    </div>

</div>

</div>
