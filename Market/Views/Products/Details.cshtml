@model Market.Models.Product

@{
ViewData["Title"] = Model.Name;
}

<div class="details-page">

<a asp-action="Index" class="back-button">
    ← BACK TO MARKET
</a>

<div class="details-card">

    <div class="details-image">
        <img src="@Model.ImagePath"
             alt="@Model.Name" />
    </div>

    <div class="details-info">

        <span class="details-category">
            @Model.Category?.Name
        </span>

        <h1>@Model.Name</h1>

        <div class="rarity">
            @Model.Rarity
        </div>

        <p class="description">
            @Model.Description
        </p>

        <div class="details-properties">

            <div>
                <span>CONDITION</span>
                <strong>@Model.Condition</strong>
            </div>

            <div>
                <span>RATING</span>
                <strong class="details-rating">
                    ★ @Model.Rating.ToString("0.0")
                </strong>
            </div>

            <div>
                <span>RARITY</span>
                <strong>@Model.Rarity</strong>
            </div>

            <div>
                <span>CATEGORY</span>
                <strong>@Model.Category?.Name</strong>
            </div>

        </div>

        <div class="details-purchase">

            <span class="details-price">
                $@Model.Price
            </span>

            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-primary details-buy-button">
                    ADD TO CART
                </button>

            </form>

        </div>

    </div>

</div>

</div>
